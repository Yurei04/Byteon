{
  "chapters": [
    {
      "id": "chapter4",
      "title": "Pitch Day",
      "theme": ["Confidence", "Storytelling", "Celebration of Growth"],
      "background": "your_room_morning.jpg",
      "music": "soft_lofi_piano.mp3",
      "events": [
        {
          "id": "scene1",
          "dialogs": [
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "It’s the final moments of your hackathon journey. One last challenge remains — the pitch."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "You check your laptop: slides, script, GitHub repository, live site, and submission form."
            },
            {
              "character": "You",
              "pose": "concerned",
              "text": "Okay… five-minute pitch, public repo, live site, and submission. No pressure."
            },
            {
              "character": "Aira",
              "pose": "smile",
              "text": "Today, your idea becomes visible to the world."
            },
            {
              "character": "You",
              "pose": "concerned",
              "text": "I’ve never presented anything before. What if I freeze up?"
            },
            {
              "character": "Aira",
              "pose": "smile",
              "text": "Take a breath and keep going. Everyone’s first pitch feels scary."
            },
            {
              "character": "You",
              "pose": "thinking",
              "text": "So… how do I start?"
            },
            {
              "character": "Aira",
              "pose": "grin",
              "text": "With a story. Your pitch has five parts: INTRO, PROBLEM, SOLUTION, IMPACT, and CLOSING."
            }
          ]
        },
        {
          "id": "scene2",
          "music": "upbeat_instrumental.mp3",
          "dialogs": [
            {
              "character": "Aira",
              "pose": "teaching",
              "text": "Start with the INTRO to grab attention with a story, question, or powerful fact."
            },
            {
              "character": "Aira",
              "pose": "teaching",
              "text": "Then explain the PROBLEM and SOLUTION, show the IMPACT, and finish with a memorable CLOSING."
            },
            {
              "character": "Aira",
              "pose": "teaching",
              "text": "Keep it simple, human, and memorable."
            }
          ]
        },
        {
          "id": "scene3",
          "background": "your_room_afternoon.jpg",
          "music": "rising_melody.mp3",
          "dialogs": [
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Timer: 02:12:35 remaining. Your team joins a call."
            },
            {
              "character": "Maya",
              "pose": "smile",
              "text": "We’ll screen record the demo while someone narrates."
            },
            {
              "character": "Kenji",
              "pose": "smile",
              "text": "Let’s make sure the app doesn’t crash."
            },
            {
              "character": "Luna",
              "pose": "smile",
              "text": "I’ll handle the final UI walkthrough."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Aira projects the five-minute structure: Hook, Problem, Solution Demo, Technical Stack, and Impact & Future Plans."
            }
          ],
          "minigame": {
            "minigame_type": "MultipleChoice",
            "minigame_title": "Recording Ready",
            "description": "Choose the best answer!",
            "tasks": [
              {
                "id": 1,
                "task": "What’s MOST important when starting your hackathon pitch video?",
                "options": [
                  "Grab attention with fancy effects",
                  "Clear explanation of the problem + solution",
                  "Long background music",
                  "Detailed technical slides"
                ],
                "correct_answer": [
                  "Clear explanation of the problem + solution"
                ]
              },
              {
                "id": 2,
                "task": "What should your demo focus on MOST?",
                "options": [
                  "Highlighting the core functionality clearly",
                  "Showing every single feature",
                  "Adding exciting sound effects",
                  "Using transitions between clips"
                ],
                "correct_answer": [
                  "Highlighting the core functionality clearly"
                ]
              },
              {
                "id": 3,
                "task": "During your video, what matters most to judges?",
                "options": [
                  "Fast camera movements",
                  "Trendy background music",
                  "Fancy lower-third graphics",
                  "Easy-to-understand demo and explanation"
                ],
                "correct_answer": [
                  "Easy-to-understand demo and explanation"
                ]
              },
              {
                "id": 4,
                "task": "What matters most for your audio during recording?",
                "options": [
                  "Background music louder than speaking",
                  "Sound effects in every transition",
                  "Voice clearly audible and no distracting noise",
                  "Lots of echo for style"
                ],
                "correct_answer": [
                  "Voice clearly audible and no distracting noise"
                ]
              },
              {
                "id": 5,
                "task": "What is the MOST important storytelling element in a pitch video?",
                "options": [
                  "Simple explanation of problem → solution → impact",
                  "Most transitions possible",
                  "Complex jargon and buzzwords",
                  "Lowest background music volume"
                ],
                "correct_answer": [
                  "Simple explanation of problem → solution → impact"
                ]
              }
            ]
          }
        },
        {
          "id": "scene4",
          "music": "soft_ambient.mp3",
          "dialogs": [
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "You hit record. You introduce the problem, demo the core feature, show the SDG alignment, and briefly explain the tech stack."
            }
          ],
          "minigame": {
            "minigame_type": "MultipleChoice",
            "minigame_title": "Pitch Perfect",
            "description": "Choose the best line for each part of your pitch.",
            "tasks": [
              {
                "id": 1,
                "task": "Intro",
                "options": [
                  "Hi, my name is [Name]. I’m here to present my app.",
                  "Have you ever felt stuck studying alone, wishing someone could keep you going?"
                ],
                "correct_answer": [
                  "Have you ever felt stuck studying alone, wishing someone could keep you going?"
                ]
              },
              {
                "id": 2,
                "task": "Problem",
                "options": [
                  "Students are lazy.",
                  "Many students lose motivation when learning online due to lack of connection."
                ],
                "correct_answer": [
                  "Many students lose motivation when learning online due to lack of connection."
                ]
              },
              {
                "id": 3,
                "task": "Solution",
                "options": [
                  "We made an app that sends random alerts.",
                  "We built FocusFriend — an AI buddy that gamifies your study habits."
                ],
                "correct_answer": [
                  "We built FocusFriend — an AI buddy that gamifies your study habits."
                ]
              },
              {
                "id": 4,
                "task": "Impact",
                "options": [
                  "It’s kinda fun.",
                  "FocusFriend helps students feel proud of their progress and less alone."
                ],
                "correct_answer": [
                  "FocusFriend helps students feel proud of their progress and less alone."
                ]
              },
              {
                "id": 5,
                "task": "Closing",
                "options": [
                  "Thank you.",
                  "Together, let’s make learning more human — one study session at a time."
                ],
                "correct_answer": [
                  "Together, let’s make learning more human — one study session at a time."
                ]
              }
            ]
          }
        },
        {
          "id": "scene5",
          "dialogs": [
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Five minutes later—"
            },
            {
              "character": "Kenji",
              "pose": "smile",
              "text": "No crashes."
            },
            {
              "character": "Luna",
              "pose": "smile",
              "text": "Nice work, rookie! That was sharp."
            },
            {
              "character": "Maya",
              "pose": "smile",
              "text": "See? You had it in you."
            },
            {
              "character": "You",
              "pose": "thinking",
              "text": "We actually sound… legit."
            },
            {
              "character": "Aira",
              "pose": "smile",
              "text": "They’re proud of you. And so am I."
            },
            {
              "character": "You",
              "pose": "smile",
              "text": "Thanks, Aira. For everything."
            }
          ],
          "achievement": {
            "title": "Pitch Master",
            "description": "Completed the Pitch Perfect mini-game and delivered a successful pitch.",
            "reward_points": 20,
            "icon": "pitch_master.png"
          }
        },
        {
          "id": "scene6",
          "dialogs": [
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "You upload Byteon_FinalPitch.mp4 to YouTube and make sure the judges can access it."
            },
            {
              "character": "Kenji",
              "pose": "smile",
              "text": "Wait. Remove API keys."
            },
            {
              "character": "Luna",
              "pose": "teaching",
              "text": "Never upload sensitive credentials."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "You clean the README, add installation instructions, tech stack, screenshots, and a license, then push the final GitHub commit."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "The deployed site loads. Login works. The core feature runs without errors."
            },
            {
              "character": "Luna",
              "pose": "teaching",
              "text": "It’s live!"
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "You complete the project description and attach the demo, GitHub, website, and screenshots."
            },
            {
              "character": "Aira",
              "pose": "smile",
              "text": "Double-check everything before you submit."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Video link works. GitHub is public. Website is accessible. SDG and team members are listed."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Timer: 00:18:52 remaining. Your cursor hovers over Submit Project."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "You click Submit Project. Loading…"
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Submission Successfully Received."
            }
          ]
        },
        {
          "id": "scene7",
          "music": "triumphant_synth.mp3",
          "dialogs": [
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "The countdown disappears. Confetti fills your screen."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Your team celebrates: “WE DID IT!”"
            },
            {
              "character": "You",
              "pose": "proud",
              "text": "We built it. We recorded it. We shipped it."
            },
            {
              "character": "Aira",
              "pose": "smile",
              "text": "You didn’t just participate. You published."
            },
            {
              "character": "Aira",
              "pose": "smile",
              "text": "You learned how to turn an idea into something real."
            },
            {
              "character": "Luna",
              "pose": "smile",
              "text": "From blank canvas to live product."
            },
            {
              "character": "Kenji",
              "pose": "smile",
              "text": "From bug panic to deployment."
            },
            {
              "character": "Maya",
              "pose": "smile",
              "text": "From nervous silence to confident pitch."
            },
            {
              "character": "Aira",
              "pose": "smile",
              "text": "Every expert was once a beginner who dared to click Register."
            },
            {
              "character": "You",
              "pose": "happy",
              "text": "Thanks, Aira. For everything."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Congratulations. You’ve completed your first hackathon journey."
            }
          ],
          "completion_message": "Complete Chapter 4",
          "achievement": {
            "title": "First Hacker Medal",
            "description": "Complete Chapter 4 of How to Hackathon",
            "reward_points": 10,
            "icon": "chapter4complete.png",
            "end": true
          }
        }
      ]
    }
  ],
