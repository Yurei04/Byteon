{
  "chapters": [
    {
      "id": "chapter3",
      "title": "The Idea Sprint",
      "background": "your_room_afternoon.jpg",
      "music": "lofi_soft.mp3",
      "events": [
        {
          "id": "scene1",
          "dialogs": [
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "You open your laptop, ready to turn your team's strengths into an actual hackathon idea."
            },
            {
              "character": "You",
              "pose": "thinking",
              "text": "So... how do we actually come up with an idea?"
            },
            {
              "character": "Aira",
              "pose": "grinning",
              "text": "Start simple: What problem do you want to solve, who are you helping, and how can technology help?"
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Aira brings you into the Idea Sprint Chamber, filled with possible challenges."
            },
            {
              "character": "Aira",
              "pose": "teaching",
              "text": "Remember: Problem + Technology + Impact = Idea. Create first, refine later."
            }
          ]
        },
        {
          "id": "scene2",
          "type": "choice",
          "prompt": "What kind of challenge excites you the most?",
          "choices": [
            {
              "text": "Helping the environment",
              "nextScene": "scene2_env"
            },
            {
              "text": "Improving education",
              "nextScene": "scene2_edu"
            },
            {
              "text": "Supporting mental health",
              "nextScene": "scene2_health"
            },
            {
              "text": "Making technology more accessible",
              "nextScene": "scene2_access"
            }
          ]
        },
        {
          "id": "scene2_env",
          "dialogs": [
            {
              "character": "Aira",
              "pose": "happy",
              "text": "Great choice! Sustainability problems can lead to meaningful technology solutions."
            }
          ]
        },
        {
          "id": "scene2_edu",
          "dialogs": [
            {
              "character": "Aira",
              "pose": "smiling",
              "text": "Great choice! Education challenges are perfect opportunities for accessible technology."
            }
          ]
        },
        {
          "id": "scene2_health",
          "dialogs": [
            {
              "character": "Aira",
              "pose": "gentle",
              "text": "Great choice! Technology can support people and communities through thoughtful mental health solutions."
            }
          ]
        },
        {
          "id": "scene2_access",
          "dialogs": [
            {
              "character": "Aira",
              "pose": "grinning",
              "text": "Great choice! Accessibility projects can make technology more inclusive for everyone."
            }
          ]
        },
        {
          "id": "scene3",
          "title": "Idea Builder MiniGame",
          "dialogs": [
            {
              "character": "You",
              "pose": "tired",
              "text": "But what if everything has already been done?"
            },
            {
              "character": "Aira",
              "pose": "gentle",
              "text": "Innovation doesn't always mean something completely new. It can mean making an existing solution better, simpler, or more useful."
            },
            {
              "character": "Aira",
              "pose": "grinning",
              "text": "Ready to build an idea?"
            }
          ],
          "minigame": {
            "minigame_type": "IdeaBuilderMiniGame",
            "minigame_title": "SDG Impact Builder — Scenario Solver",
            "builds": [
              {
                "id": 1,
                "scenario": "People want new shoes but aren't sure where to buy them.",
                "problem": {
                  "options": [
                    "People don't know where to look",
                    "Shoe stores are closed",
                    "Designers dislike sneakers"
                  ],
                  "correct": "People don't know where to look"
                },
                "solution": {
                  "options": [
                    "Create a curated store list",
                    "Build a new shoe prototype",
                    "Rewrite the app's backend"
                  ],
                  "correct": "Create a curated store list"
                },
                "sdg": {
                  "options": [
                    "SDG 8: Decent Work and Economic Growth",
                    "SDG 13: Climate Action",
                    "SDG 4: Quality Education"
                  ],
                  "correct": "SDG 8: Decent Work and Economic Growth",
                  "hint": "Which goal supports local businesses and consumer access?"
                }
              },
              {
                "id": 2,
                "scenario": "A community is unable to access fresh produce after a storm.",
                "problem": {
                  "options": [
                    "Bad weather blocking deliveries",
                    "Lack of designers",
                    "Too many shoes"
                  ],
                  "correct": "Bad weather blocking deliveries"
                },
                "solution": {
                  "options": [
                    "Set up temporary market stalls",
                    "Hire a presenter",
                    "Redesign the logo"
                  ],
                  "correct": "Set up temporary market stalls"
                },
                "sdg": {
                  "options": [
                    "SDG 2: Zero Hunger",
                    "SDG 7: Affordable and Clean Energy",
                    "SDG 16: Peace and Justice"
                  ],
                  "correct": "SDG 2: Zero Hunger",
                  "hint": "Which goal addresses food security and access?"
                }
              },
              {
                "id": 3,
                "scenario": "Users are confused by the app navigation and leave quickly.",
                "problem": {
                  "options": [
                    "Navigation is unclear",
                    "Servers are too fast",
                    "The pitch is too long"
                  ],
                  "correct": "Navigation is unclear"
                },
                "solution": {
                  "options": [
                    "Add clear user-flow hints",
                    "Increase server CPU",
                    "Write a long pitch script"
                  ],
                  "correct": "Add clear user-flow hints"
                },
                "sdg": {
                  "options": [
                    "SDG 9: Industry, Innovation and Infrastructure",
                    "SDG 14: Life Below Water",
                    "SDG 15: Life on Land"
                  ],
                  "correct": "SDG 9: Industry, Innovation and Infrastructure",
                  "hint": "Which goal promotes accessible technology and innovation?"
                }
              },
              {
                "id": 4,
                "scenario": "The team needs users to test their prototype this weekend.",
                "problem": {
                  "options": [
                    "No testers available",
                    "Design trend is outdated",
                    "Coffee is too hot"
                  ],
                  "correct": "No testers available"
                },
                "solution": {
                  "options": [
                    "Run a weekend testing pop-up",
                    "Change the color palette",
                    "Refactor CSS only"
                  ],
                  "correct": "Run a weekend testing pop-up"
                },
                "sdg": {
                  "options": [
                    "SDG 17: Partnerships for the Goals",
                    "SDG 6: Clean Water and Sanitation",
                    "SDG 11: Sustainable Cities"
                  ],
                  "correct": "SDG 17: Partnerships for the Goals",
                  "hint": "Which goal emphasizes collaboration and community engagement?"
                }
              },
              {
                "id": 5,
                "scenario": "The team wants to get press attention for their app launch.",
                "problem": {
                  "options": [
                    "No media contacts",
                    "Prototype has too many features",
                    "Servers are down"
                  ],
                  "correct": "No media contacts"
                },
                "solution": {
                  "options": [
                    "Prepare a press kit and outreach list",
                    "Add more animations",
                    "Encrypt the database"
                  ],
                  "correct": "Prepare a press kit and outreach list"
                },
                "sdg": {
                  "options": [
                    "SDG 9: Industry, Innovation and Infrastructure",
                    "SDG 3: Good Health and Well-being",
                    "SDG 12: Responsible Consumption"
                  ],
                  "correct": "SDG 9: Industry, Innovation and Infrastructure",
                  "hint": "Which goal supports innovation awareness and technology advancement?"
                }
              }
            ],
            "completion_message": "You matched problems, solutions and SDGs like a pro — mission complete!",
            "achievement": {
              "title": "SDG Scenario Master",
              "description": "Perfectly matched all problem-solution-SDG scenarios",
              "badge": "🎯🌍"
            }
          }
        },
        {
          "id": "scene4",
          "dialogs": [
            {
              "character": "Aira",
              "pose": "clapping",
              "text": "Nice work! You matched problems, solutions, and SDGs."
            },
            {
              "character": "You",
              "pose": "happy",
              "text": "I didn't realize brainstorming could be this simple."
            },
            {
              "character": "Aira",
              "pose": "smiling",
              "text": "That's the hackathon mindset: don't wait for a perfect idea. Build, test, and improve."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "Your team starts building. The hackathon clock is running."
            },
            {
              "character": "Kenji",
              "pose": "smile",
              "text": "Uh... guys? The login system isn't connecting to the database."
            },
            {
              "character": "You",
              "pose": "thinking",
              "text": "Is that bad?"
            },
            {
              "character": "Aira",
              "pose": "grinning",
              "text": "It's a bug. Don't panic. Hackathons are about recovery too."
            }
          ],
          "minigame": {
            "minigame_type": "MultipleChoice",
            "minigame_title": "Bug Response",
            "description": "Aira (voice-over): Drag and drop each role to the task. Choose the best response:",
            "tasks": [
              {
                "id": 1,
                "task": "What do you when there is a bug?",
                "options": [
                  "Panic",
                  "Scrap everything",
                  "Debug step-by-step"
                ],
                "correct_answer": [
                  "Debug step-by-step"
                ]
              },
              {
                "id": 2,
                "task": "Which technique helps you find errors by going through the code step by step?",
                "options": [
                  "Guessing solutions",
                  "Debug step-by-step",
                  "Skipping tests"
                ],
                "correct_answer": [
                  "Debug step-by-step"
                ]
              },
              {
                "id": 3,
                "task": "Which of the following is *not* a common debugging action?",
                "options": [
                  "Check error messages",
                  "Change random lines",
                  "Test after fixes"
                ],
                "correct_answer": [
                  "Change random lines"
                ]
              },
              {
                "id": 4,
                "task": "What is the first step in debugging a code issue?",
                "options": [
                  "Run the code without looking",
                  "Identify and understand the problem",
                  "Ask someone else to do it"
                ],
                "correct_answer": [
                  "Identify and understand the problem"
                ]
              },
              {
                "id": 5,
                "task": "What does debugging typically involve in programming?",
                "options": [
                  "Coding without errors",
                  "Improving performance",
                  "Finding and resolving bugs",
                  "Designing new features"
                ],
                "correct_answer": [
                  "Finding and resolving bugs"
                ]
              }
            ],
            "dialogue": [
              {
                "character": "Narrator",
                "pose": "neutral",
                "text": "Kenji shares screen. You help test inputs. After 20 tense minutes—"
              },
              {
                "character": "Kenji",
                "pose": "smiling",
                "text": "It’s fixed!"
              },
              {
                "character": "Narrator",
                "pose": "neutral",
                "text": "Everyone cheers."
              }
            ]
          }
        },
        {
          "id": "scene5",
          "dialogs": [
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "After debugging, the team gets the core feature working. They review their progress and prepare for submission."
            },
            {
              "character": "Luna",
              "pose": "smile",
              "text": "I'll improve the important screens."
            },
            {
              "character": "Kenji",
              "pose": "smile",
              "text": "I'll make sure the demo is stable."
            },
            {
              "character": "Maya",
              "pose": "smile",
              "text": "I'll refine the problem statement and impact."
            },
            {
              "character": "Aira",
              "pose": "smiling",
              "text": "Focus on the core feature first. Fancy extras can wait."
            },
            {
              "character": "You",
              "pose": "determined",
              "text": "We're actually doing this."
            },
            {
              "character": "Narrator",
              "pose": "neutral",
              "text": "The timer keeps counting down. The team is ready for the next challenge: the pitch."
            }
          ],
          "completion_message": "Completed Chapter 3",
          "achievement": {
            "title": "Innovation Spark",
            "description": "Complete Chapter 3 of How to Hackathon",
            "reward_points": 10,
            "icon": "chapter3complete.png"
          }
        }
      ]
    }
  ],
